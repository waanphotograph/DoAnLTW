@using System.Text.Json
@using DoAnLTW.Data
@using DoAnLTW.Models
@inject ApplicationDbContext _context

@{
    var fullName = Context.Session.GetString("FullName");
    var role = Context.Session.GetString("Role");

    // Tính tổng số lượng sản phẩm thật trong Giỏ hàng (Session)
    int cartCount = 0;
    var cartJson = Context.Session.GetString("MY_CART");
    if (!string.IsNullOrEmpty(cartJson))
    {
        var cart = JsonSerializer.Deserialize<List<CartItem>>(cartJson);
        cartCount = cart?.Sum(x => x.Quantity) ?? 0;
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreshMart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/user/css/user.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <!-- Thanh thông báo trên cùng -->
    <div class="top-strip">
        <div class="container d-flex justify-content-between align-items-center">
            <span>🚚 Giao hàng nhanh – Thực phẩm tươi mỗi ngày</span>
            <div class="d-flex align-items-center gap-3">
                <span>☎ Hotline: 1900 6868</span>
                @if (role == "Admin")
                {
                    <a class="text-white fw-bold text-decoration-underline" asp-area="Admin" asp-controller="Order" asp-action="Index">⚙ Trang Quản trị</a>
                }
            </div>
        </div>
    </div>

    <header class="bg-white sticky-top shadow-sm">
        <div class="container py-3">
            <div class="row align-items-center g-3">
                <!-- Logo -->
                <div class="col-6 col-lg-3">
                    <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-icon">F</span> Fresh<span>Mart</span>
                    </a>
                </div>

                <!-- Thanh tìm kiếm -->
                <div class="col-12 col-lg-5 order-3 order-lg-2">
                    <form asp-area="" asp-controller="Home" asp-action="Index" method="get" class="search-box">
                        <input class="form-control" type="search" name="search" value="@Context.Request.Query["search"]" placeholder="Tìm rau củ, thịt, sữa, bánh kẹo..." />
                        <button class="btn btn-brand rounded-pill px-3" type="submit">Tìm kiếm</button>
                    </form>
                </div>

                <!-- Cụm Giỏ hàng + Tài khoản -->
                <div class="col-6 col-lg-4 order-2 order-lg-3 d-flex justify-content-end align-items-center gap-2 flex-wrap">
                    <a class="cart-link me-2" asp-area="" asp-controller="Cart" asp-action="Index">
                        🛒 Giỏ hàng <span id="cart-count" class="cart-count">@cartCount</span>
                    </a>

                    @if (!string.IsNullOrEmpty(fullName))
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-brand btn-sm rounded-pill dropdown-toggle px-3" type="button" data-bs-toggle="dropdown">
                                👤 @fullName
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                @if (role == "Admin")
                                {
                                    <li><a class="dropdown-item fw-semibold text-primary" asp-area="Admin" asp-controller="Order" asp-action="Index">⚙ Vào trang Admin</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li><a class="dropdown-item" asp-area="" asp-controller="Cart" asp-action="Index">🛒 Giỏ hàng của tôi</a></li>
                                <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout">🚪 Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-brand btn-sm rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        <a class="btn btn-brand btn-sm rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    }
                </div>
            </div>
        </div>

        <!-- Menu Danh mục -->
        <nav class="navbar navbar-expand-lg navbar-light border-top">
            <div class="container">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-5">
                    <a class="brand footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-icon">F</span> Fresh<span>Mart</span>
                    </a>
                    <p class="mt-3 text-white-50">Siêu thị thực phẩm trực tuyến – mang thực phẩm chất lượng đến mọi gia đình.</p>
                </div>
                <div class="col-6 col-md-3">
                    <h6>Thông tin</h6>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <a asp-area="" asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                    <a asp-area="" asp-controller="Account" asp-action="Login">Tài khoản</a>
                </div>
                <div class="col-6 col-md-4">
                    <h6>Liên hệ</h6>
                    <p>☎ 1900 6868</p>
                    <p>✉ support@freshmart.vn</p>
                    <p>📍 140 Lê Trọng Tấn, Tân Phú, TP.HCM</p>
                </div>
            </div>
        </div>
        <div class="footer-bottom text-center py-3">© 2026 FreshMart. Đồ án Lập trình Web.</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>