@model List<DoAnLTW.Models.CartItem>
@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
    double grandTotal = Model != null ? Model.Sum(x => x.Price * x.Quantity) : 0;
}

<section class="container page-container">
    <div class="breadcrumb-line">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a> / Giỏ hàng
    </div>

    <div class="page-heading">
        <div>
            <span class="eyebrow">ĐƠN HÀNG CỦA BẠN</span>
            <h1>Giỏ hàng</h1>
            <p>Kiểm tra sản phẩm trước khi tiến hành đặt hàng.</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div class="emoji">🛒</div>
            <h4>Giỏ hàng của bạn đang trống</h4>
            <p>Hãy chọn thêm vài sản phẩm tươi ngon vào giỏ nhé.</p>
            <a asp-controller="Home" asp-action="Products" class="btn btn-brand rounded-pill px-4">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="table-responsive bg-white rounded-4 p-3 shadow-sm">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="~/images/products/@item.ImageUrl" alt="@item.ProductName"
                                                 style="width: 60px; height: 60px; object-fit: cover; border-radius: 10px;" />
                                            <span class="fw-semibold">@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td>@item.Price.ToString("N0")đ</td>
                                    <td>@item.Quantity</td>
                                    <td class="fw-bold text-success">@((item.Price * item.Quantity).ToString("N0"))đ</td>
                                    <td>
                                        <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId"
                                           class="btn btn-sm btn-outline-danger">Xóa</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-white rounded-4 p-4 shadow-sm">
                    <h5 class="mb-3">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Tổng cộng:</span>
                        <strong class="fs-5 text-danger">@grandTotal.ToString("N0")đ</strong>
                    </div>

                    <form asp-controller="Cart" asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Số điện thoại nhận hàng</label>
                            <input type="tel" name="orderPhone" class="form-control" placeholder="VD: 0901234567" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Địa chỉ giao hàng</label>
                            <textarea name="shippingAddress" class="form-control" rows="2" placeholder="Nhập địa chỉ chi tiết..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-brand w-100 rounded-pill py-2">
                            Tiến hành đặt hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</section>