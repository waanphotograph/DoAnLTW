@model DoAnLTW.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderId;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Chi tiết Đơn hàng #@Model.OrderId</h2>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-bold">Thông tin khách hàng</div>
                <div class="card-body">
                    <p><strong>Họ tên:</strong> @Model.Account?.FullName</p>
                    <p><strong>Số điện thoại:</strong> @Model.OrderPhone</p>
                    <p><strong>Địa chỉ giao:</strong> @Model.ShippingAddress</p>
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-bold">Cập nhật trạng thái đơn hàng</div>
                <div class="card-body">
                    <p>Trạng thái hiện tại: <strong class="text-primary">@Model.Status</strong></p>
                    <form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
                        <input type="hidden" name="id" value="@Model.OrderId" />
                        <select name="status" class="form-select">
                            <option value="Chờ duyệt" selected="@(Model.Status == "Chờ duyệt")">Chờ duyệt</option>
                            <option value="Đang giao" selected="@(Model.Status == "Đang giao")">Đang giao</option>
                            <option value="Hoàn thành" selected="@(Model.Status == "Hoàn thành")">Hoàn thành</option>
                            <option value="Đã hủy" selected="@(Model.Status == "Đã hủy")">Đã hủy</option>
                        </select>
                        <button type="submit" class="btn btn-success">Cập nhật</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <h4>Danh sách sản phẩm trong đơn</h4>
    <table class="table table-bordered align-middle">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.OrderDetails != null)
            {
                foreach (var detail in Model.OrderDetails)
                {
                    <tr>
                        <td>@detail.Product?.ProductName</td>
                        <td>@detail.DonGia.ToString("N0") đ</td>
                        <td>@detail.SoLuong</td>
                        <td>@((detail.SoLuong * detail.DonGia).ToString("N0")) đ</td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                <td class="fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</td>
            </tr>
        </tfoot>
    </table>
</div>